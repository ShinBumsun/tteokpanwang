#!/bin/sh
# push 할 때 카페24에 함께 반영합니다.
# 건너뛰려면 : SKIP_DEPLOY=1 git push
if [ "$SKIP_DEPLOY" = "1" ]; then
	echo "[배포] SKIP_DEPLOY=1 이라 건너뜁니다."
	exit 0
fi

ROOT=$(git rev-parse --show-toplevel)

# 테마는 index.html 로 만든 결과물이라, 다시 만들어 보고 커밋본과 다르면 멈춘다.
python3 "$ROOT/tools/build_theme.py" >/dev/null || exit 1
if ! git -C "$ROOT" diff --quiet -- gnuboard/theme; then
	echo "[배포] 테마가 index.html 과 달라 다시 만들었습니다. 바뀐 gnuboard/theme 를 커밋한 뒤 다시 push 해 주세요."
	exit 1
fi

if [ ! -f "$ROOT/.deploy.env" ]; then
	echo "[배포] .deploy.env 가 없어 카페24 반영은 건너뜁니다. (DEPLOY.md 참고)"
	exit 0
fi

echo "[배포] 카페24에 반영 중..."
if python3 "$ROOT/tools/deploy_ftp.py"; then
	echo "[배포] 완료"
	exit 0
else
	echo "[배포] 실패 — push 를 중단합니다. 건너뛰려면 SKIP_DEPLOY=1 git push"
	exit 1
fi
